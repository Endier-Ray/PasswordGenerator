---
import { useTranslations } from '../i18n';
const locale = Astro.currentLocale === 'es' ? 'es' : 'en';
const t = useTranslations(locale);
---
<section class="content-generator" id="generator" aria-label={t('password.generator.config.label')}>
    <div class="output-area">
        <span class="section-label">{t('password.generator.span')}</span>
        <p id="output" aria-live="polite" data-placeholder={t('password.generator.slot')} data-generating={t('password.generator.status.generating')} data-error-label={t('password.generator.status.error')} data-unknown-error={t('password.generator.status.unknownError')}></p>
        <div class="actions">
            <button id="generate" type="button">{t('password.generator.button')}</button>
            <button id="copy" type="button" disabled data-copy-label={t('password.generator.copy')} data-copied-label={t('password.generator.status.copied')}>{t('password.generator.copy')}</button>
        </div>
    </div>
    <div class="configuration">
        <span class="section-label">{t('password.generator.config.label')}</span>
        <div class="length-controls">
            <div class="length-heading">
                <label for="length">{t('password.generator.config.length')}</label>
                <span id="length-value">16</span>
            </div>
            <input type="range" id="length" min="4" max="64" value="16" />
            <div class="range-ends" aria-hidden="true"><span>04</span><span>64</span></div>
        </div>
        <fieldset>
            <legend>{t('password.generator.config.characters')}</legend>
            <label for="include-uppercase" ><input type="checkbox" id="include-uppercase" checked/> {t('password.generator.config.option.uppercase')}</label>
            <label for="include-lowercase"><input type="checkbox" id="include-lowercase" checked/> {t('password.generator.config.option.lowercase')}</label>
            <label for="include-numbers"><input type="checkbox" id="include-numbers" checked/> {t('password.generator.config.option.numbers')}</label>
            <label for="include-symbols"><input type="checkbox" id="include-symbols" checked/> {t('password.generator.config.option.symbols')}</label>
        </fieldset>
    </div>
</section>

<script src="../scripts/generatorPayload.ts"></script>

<style>
    .content-generator {
        min-width: 0;
        background: var(--panel-bg);
        border:1px solid var(--color-secondary);
        border-radius: var(--border-radius-sm);
        overflow: hidden;
        box-shadow: 8px 8px 0 var(--shadow-color);
    }

    .output-area, .configuration {
        padding: clamp(1.5rem, 3.5vw, 3rem);
    }

    .output-area {
        position: relative;
        background: var(--color-primary);
        color: var(--panel-bg);
    }

    .output-area::before {
        position: absolute;
        inset: 0 0 auto;
        height: 4px;
        background: var(--color-secondary);
        content: '';
    }

    .section-label {
        display: block;
        color: var(--color-primary);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
    }

    .output-area .section-label { color: var(--color-primary-glow); }

    #output {
        display: flex;
        align-items: center;
        min-height: 6rem;
        margin: 1rem 0 1.25rem;
        font-family: var(--font-family);
        font-size: clamp(1.25rem, 2.7vw, 2rem);
        font-weight: 500;
        line-height: 1.4;
        overflow-wrap: anywhere;
        color: var(--panel-bg);
    }

    #output:empty::before {
        content: attr(data-placeholder);
        color: var(--color-primary-glow);
        font-family: var(--font-family);
        font-weight: 400;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    button {
        min-height: 3.25rem;
        padding: 0.75rem 1.25rem;
        border-radius: var(--border-radius-sm);
        border: 1px solid var(--color-secondary-hover);
        background: transparent;
        color: var(--panel-bg);
        font: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background var(--motion-fast), color var(--motion-fast), transform var(--motion-fast);
    }

    button:hover:not(:disabled) {
        transform: translateY(-2px);
    }

    button:disabled {
        opacity: 0.5;
        cursor: wait;
    }

    #copy:disabled { cursor: not-allowed; }

    #generate {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        background: var(--color-secondary);
        border-color: var(--color-secondary);
        color: var(--color-primary);
    }

    #generate:hover:not(:disabled) {
        background: var(--color-secondary-hover);
        border-color: var(--color-secondary-hover);
    }

    #generate span {
        font-size: 1.2rem;
        line-height: 1;
    }

    #copy:hover:not(:disabled) {
        background: color-mix(in srgb, var(--color-primary) 80%, var(--color-secondary));
    }

    .configuration {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        gap: 1rem clamp(2rem, 5vw, 5rem);
    }

    .configuration > .section-label { grid-column: 1 / -1; }

    .length-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 0 1.25rem;
        font-weight: 600;
    }

    #length-value {
        min-width: 3rem;
        padding: 0.35rem 0.5rem;
        border-radius: var(--border-radius-sm);
        background: color-mix(in srgb, var(--color-secondary) 40%, var(--panel-bg));
        color: var(--color-primary);
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    #length {
        display: block;
        width: 100%;
        margin: 0;
        accent-color: var(--color-primary);
        cursor: pointer;
    }

    .range-ends {
        display: flex;
        justify-content: space-between;
        margin-top: 0.55rem;
        color: var(--color-primary);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
    }

    fieldset {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem 1rem;
        border: 0;
        padding: 0;
        margin: 0;
    }

    legend {
        padding: 0 0.6rem 0 0;
        color: var(--color-primary);
        font-size: 0.8rem;
    }

    fieldset label {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 1rem;
        font-size: 0.88rem;
        cursor: pointer;
        border: 1px solid var(--color-secondary);
        border-radius:var(--border-radius-sm);
        transition: background var(--motion-fast), border-color var(--motion-fast), transform var(--motion-fast);
    }

    fieldset label:hover {
        background: color-mix(in srgb, var(--color-secondary) 28%, var(--panel-bg));
        border-color: var(--color-secondary-hover);
        box-shadow: 0 4px 12px var(--shadow-color);
        transform: translateY(-2px);
    }

    fieldset label:focus-within {
        border-color: var(--color-primary);
    }

    fieldset input {
        flex: none;
        width: 1.15rem;
        height: 1.15rem;
        margin: 0;
        accent-color: var(--color-primary);
        cursor: pointer;
    }

    :is(button, input):focus-visible {
        outline: 3px solid var(--color-secondary);
        outline-offset: 3px;
    }

    @media (max-width: 520px) {
        .actions button { width: 100%; }
        fieldset { grid-template-columns: 1fr; gap: 0.25rem; }
    }

    @media (max-width: 720px) {
        .configuration { grid-template-columns: 1fr; gap: 1.5rem; }
        fieldset { border-top: 1px solid var(--color-secondary-hover); padding-top: 1.4rem; }
    }
</style>