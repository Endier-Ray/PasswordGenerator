---
import { useTranslations } from '../i18n';

const locale = Astro.currentLocale === 'es' ? 'es' : 'en';
const t = useTranslations(locale);
const pagePath = locale === 'es' ? Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/' : Astro.url.pathname;
const isDocumentation = pagePath.startsWith('/documentation');
const homePath = locale === 'es' ? '/es/' : '/';
const documentationPath = locale === 'es' ? '/es/documentation' : '/documentation';
---

<section class="content-top-nav">
	<nav class="top-nav" aria-label={t('top.nav.label')}>
		<ul>
			<li><a href={`${homePath}#generator`} aria-current={!isDocumentation ? 'page' : undefined}>{t('top.nav.generator')}</a></li>
			<li><a href={documentationPath} aria-current={isDocumentation ? 'page' : undefined}>{t('top.nav.documentation')}</a></li>
			<li><a href="https://github.com/Endier-Ray/PasswordGenerator" target="_blank" rel="noopener noreferrer">GitHub</a></li>
			<li><button class="language-toggle" type="button" data-language-switch data-target-locale={locale === 'es' ? 'en' : 'es'} aria-label={t('language.switch')} title={t('language.switch')}>{locale === 'es' ? 'EN' : 'ES'}</button></li>
		</ul>
	</nav>
</section>

<script>
	const languageButton = document.querySelector<HTMLButtonElement>('[data-language-switch]');
	if (languageButton) {
		languageButton.addEventListener('click', () => {
			const nextLocale = languageButton.dataset.targetLocale;
			if (nextLocale !== 'en' && nextLocale !== 'es') return;

			try {
				localStorage.setItem('preferred-locale', nextLocale);
			} catch {
				// The URL still changes when browser storage is unavailable.
			}

			const currentPath = window.location.pathname;
			const defaultPath = currentPath.replace(/^\/es(?=\/|$)/, '') || '/';
			const nextPath = nextLocale === 'es'
				? defaultPath === '/' ? '/es/' : `/es${defaultPath}`
				: defaultPath;
			window.location.assign(`${nextPath}${window.location.search}${window.location.hash}`);
		});
	}
</script>

<style>
	.content-top-nav {
		width: 100%;
		border-bottom: 1px solid var(--color-secondary-hover);
		background: color-mix(in srgb, var(--panel-bg) 85%, transparent);
	}

	.top-nav {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 1.5rem;
		width: min(100%, 1440px);
		min-height: 5.5rem;
		margin: 0 auto;
		padding: 0 var(--content-inline-padding);
	}

	.top-nav ul {
		list-style: none;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: clamp(1rem, 3vw, 2.5rem);
		margin: 0;
		padding: 0;
	}

	.top-nav a {
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-primary);
		transition: text-decoration-color var(--motion-fast);
	}

	.top-nav a:is(:hover, [aria-current="page"]) {
		text-decoration: underline;
		text-decoration-color: var(--color-secondary-hover);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.45rem;
	}

	.language-toggle {
		min-width: 2.75rem;
		min-height: 2.25rem;
		border: 1px solid var(--color-secondary-hover);
		border-radius: var(--border-radius-sm);
		background: var(--panel-bg);
		color: var(--color-primary);
		font: inherit;
		font-size: 0.78rem;
		font-weight: 700;
		cursor: pointer;
	}

	.language-toggle:hover { background: var(--color-secondary); }
	a:focus-visible, button:focus-visible { outline: 3px solid var(--color-secondary); outline-offset: 4px; }

	@media (max-width: 460px) {
		.top-nav { min-height: 4.8rem; }
		.top-nav ul { gap: 0.8rem; }
		.top-nav a { font-size: 0.78rem; }
	}
</style>