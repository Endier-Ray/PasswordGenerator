---
import '../assets/styles/main.css';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n';

const locale = Astro.currentLocale === 'es' ? 'es' : 'en';
const t = useTranslations(locale);

interface Props {
	title?: string;
	description?: string;
}

const {
	title = t('meta.home.title'),
	description = t('meta.home.description'),
} = Astro.props;
---
<!doctype html>
	<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f9f7fc" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<script is:inline>
			try {
				const savedLocale = localStorage.getItem('preferred-locale');
				const browserPrefersSpanish = navigator.languages?.some((language) => language.toLowerCase().startsWith('es'));
				const currentPath = window.location.pathname;
				const isSpanishPath = /^\/es(?:\/|$)/.test(currentPath);
				if (!isSpanishPath && (savedLocale === 'es' || (!savedLocale && browserPrefersSpanish))) {
					const spanishPath = currentPath === '/' ? '/es/' : `/es${currentPath}`;
					window.location.replace(`${spanishPath}${window.location.search}${window.location.hash}`);
				}
			} catch {
				// Continue with the language selected by the URL if browser storage is unavailable.
			}
		</script>
	</head>
	<body>
		<TopNav />
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}
</style>
